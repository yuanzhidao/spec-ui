{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables default permissions for the main loopback app window",
  "remote": {
    "urls": [
      "http://127.0.0.1:*"
    ]
  },
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "allow-runtime-snapshot",
    "allow-runtime-add-project",
    "allow-runtime-focus-project",
    "allow-runtime-remove-project",
    "allow-runtime-clear-projects",
    "allow-runtime-relocate-project",
    "allow-runtime-update-project-workspace-directory",
    "allow-runtime-update-project-worktrees-directory",
    "allow-runtime-add-project-worktree-path",
    "allow-runtime-remove-project-worktree-path",
    "allow-runtime-refresh-project",
    "allow-runtime-set-change-task-completed",
    "allow-runtime-set-theme",
    "allow-runtime-set-language",
    "allow-runtime-run-validation",
    "allow-terminal-detect-environment",
    "allow-terminal-list-sessions",
    "allow-terminal-create-session",
    "allow-terminal-write",
    "allow-terminal-resize",
    "allow-terminal-close-session"
  ]
}
