{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "spec-ui",
  "version": "0.0.3",
  "identifier": "io.github.yuanzhidao.spec-ui",
  "build": {
    "frontendDist": "../apps/desktop/dist",
    "devUrl": "http://127.0.0.1:1420",
    "beforeDevCommand": "pnpm dev:desktop-renderer",
    "beforeBuildCommand": "pnpm desktop:prepare"
  },
  "app": {
    "windows": [
      {
        "create": false,
        "title": "spec-ui",
        "width": 1280,
        "height": 860,
        "minWidth": 1024,
        "minHeight": 720,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [],
    "resources": [],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
