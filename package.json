{
  "name": "spec-ui",
  "version": "0.0.3",
  "private": true,
  "scripts": {
    "dev": "concurrently -n web,runtime -c blue,magenta \"pnpm dev:web\" \"tsx watch runtime/server.ts\"",
    "build": "pnpm --filter @spec-ui/web build",
    "start": "pnpm --filter @spec-ui/web start",
    "lint": "eslint",
    "dev:web": "pnpm --filter @spec-ui/web dev",
    "dev:runtime": "tsx watch runtime/server.ts",
    "dev:desktop-renderer": "pnpm --filter @spec-ui/desktop dev",
    "build:desktop-renderer": "pnpm --filter @spec-ui/desktop build",
    "runtime": "tsx runtime/server.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "desktop:dev": "tauri dev --config src-tauri/tauri.dev.conf.json",
    "desktop:info": "tauri info",
    "desktop:test": "node scripts/desktop-test.mjs",
    "desktop:build": "tauri build",
    "desktop:prepare": "node scripts/desktop-build.mjs",
    "release:verify": "node scripts/verify-release-version.mjs",
    "release:notes": "node scripts/generate-release-notes.mjs",
    "spec:validate": "openspec validate --all",
    "check:commit": "node scripts/check-commit.mjs",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.3",
    "@parcel/watcher": "^2.5.6",
    "@spec-ui/core": "workspace:*",
    "fast-glob": "^3.3.3",
    "hono": "^4.12.22",
    "ignore": "^7.0.5",
    "ws": "^8.21.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@fission-ai/openspec": "^1.3.1",
    "@tauri-apps/cli": "^2.11.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.1",
    "concurrently": "^9.2.1",
    "esbuild": "^0.28.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "lefthook": "^2.1.8",
    "tsx": "^4.22.3",
    "typescript": "^5",
    "vitest": "^4.1.7"
  },
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  }
}
